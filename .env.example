# Lokale Einstellungen der mobilen App – kopieren nach .env (wird nie versioniert).
# Keine Geheimnisse eintragen: EXPO_PUBLIC_-Werte landen im App-Bundle und sind öffentlich.

# Quelle für `npm run sync-api` ohne --file (lokaler Entwicklungsserver des Backends).
API_SPEC_URL=http://127.0.0.1:5000/api/openapi.json

# Basisadresse des Backends für die App (Anbindung folgt in M1.6). Auf einem echten
# Gerät im WLAN die IP des Entwicklungsrechners eintragen, z. B. http://192.168.178.20:5000;
# außerhalb von localhost und privaten Netzen ist HTTPS Pflicht.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000
